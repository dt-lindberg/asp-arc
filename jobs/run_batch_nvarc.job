#!/bin/bash

#SBATCH --job-name=GptNvarcBatch
#SBATCH --partition=gpu_h100
#SBATCH --time=04:00:00
#SBATCH --gpus=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --chdir=/home/dlindberg/Projects/asp-arc-gpt-oss-nvarc/src
#SBATCH --output=../slurm_logs/slurm_%A.out

# N_PUZZLES: number of unique puzzles to sample (default 50)
# MAX_REFINEMENT_ATTEMPTS: refinement rounds per failed puzzle (default 2, 0 = off)
# Usage: N_PUZZLES=500 sbatch jobs/run_batch_nvarc.job
#        MAX_REFINEMENT_ATTEMPTS=3 N_PUZZLES=200 sbatch jobs/run_batch_nvarc.job

set -euo pipefail

module purge
module load 2025
module load CUDA/12.8.0
module load Python/3.13.5-GCCcore-14.3.0

export HF_HOME=/scratch-shared/dlindberg/hf_cache
export HF_HUB_CACHE=$HF_HOME/hub
mkdir -p "$HF_HUB_CACHE"

export HF_HUB_ENABLE_HF_TRANSFER=1
export PYTORCH_ALLOC_CONF=expandable_segments:True

export VLLM_HOST="${VLLM_HOST:-127.0.0.1}"
export VLLM_PORT="${VLLM_PORT:-8001}"
export TP_SIZE="${TP_SIZE:-${SLURM_GPUS:-1}}"
export MAX_NUM_SEQS="${MAX_NUM_SEQS:-50}"
export N_PUZZLES="${N_PUZZLES:-50}"
export MAX_REFINEMENT_ATTEMPTS="${MAX_REFINEMENT_ATTEMPTS:-2}"

mkdir -p tiktoken_encodings
wget -nc -q -O tiktoken_encodings/o200k_base.tiktoken \
  "https://openaipublic.blob.core.windows.net/encodings/o200k_base.tiktoken" || true
wget -nc -q -O tiktoken_encodings/cl100k_base.tiktoken \
  "https://openaipublic.blob.core.windows.net/encodings/cl100k_base.tiktoken" || true
export TIKTOKEN_ENCODINGS_BASE="$PWD/tiktoken_encodings"

mkdir -p logs ../outputs

source ../.venv/bin/activate

echo "Starting vLLM server for openai/gpt-oss-120b (tp=$TP_SIZE, port=$VLLM_PORT)"

vllm serve openai/gpt-oss-120b \
  --host "$VLLM_HOST" \
  --port "$VLLM_PORT" \
  --tensor-parallel-size "$TP_SIZE" \
  --max-model-len 60000 \
  --max-num-batched-tokens 4096 \
  --max-num-seqs "$MAX_NUM_SEQS" \
  --gpu-memory-utilization 0.92 \
  --generation-config vllm &
VLLM_PID=$!

echo "Waiting for vLLM server to be ready..."
SERVER_READY=0
for i in $(seq 1 600); do
    if curl -s "http://${VLLM_HOST}:${VLLM_PORT}/v1/models" > /dev/null 2>&1; then
        echo "vLLM server ready after ${i}s"
        SERVER_READY=1
        break
    fi
    if ! kill -0 "$VLLM_PID" 2>/dev/null; then
        echo "ERROR: vLLM server died unexpectedly" >&2
        exit 1
    fi
    sleep 1
done
if [ "$SERVER_READY" -eq 0 ]; then
    echo "ERROR: vLLM server did not become ready within 600s" >&2
    kill "$VLLM_PID" 2>/dev/null || true
    exit 1
fi

python3 -m batch_pipeline \
  --n "$N_PUZZLES" \
  --max-refinement-attempts "$MAX_REFINEMENT_ATTEMPTS" \
  --output-file "../outputs/batch_${SLURM_JOB_ID}.jsonl"

kill "$VLLM_PID" 2>/dev/null || true
wait "$VLLM_PID" 2>/dev/null || true

echo ""
echo "Job complete."
